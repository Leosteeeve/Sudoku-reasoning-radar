{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sudoku-reasoning-radar.invalid/schemas/solve-trace-v1.schema.json",
  "title": "Sudoku Reasoning Radar SolveTrace v1",
  "type": "array",
  "items": { "$ref": "#/$defs/traceStep" },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "col"],
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 8 },
        "col": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "technique": {
      "enum": [
        "naked_single", "hidden_single", "locked_candidate", "box_line_reduction",
        "naked_pair", "hidden_pair", "x_wing", "mrv_guess", "exact_cover", null
      ]
    },
    "traceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "technique", "action", "targets", "candidateDeltas", "evidence",
        "branch", "explanationKey", "explanationParams"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^step-[0-9]{6}$" },
        "technique": { "$ref": "#/$defs/technique" },
        "action": {
          "enum": ["analyze", "place", "eliminate", "guess", "contradiction", "backtrack", "complete"]
        },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
        "candidateDeltas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cell", "beforeMask", "afterMask", "removedDigits"],
            "properties": {
              "cell": { "$ref": "#/$defs/cell" },
              "beforeMask": { "type": "integer", "minimum": 0, "maximum": 511 },
              "afterMask": { "type": "integer", "minimum": 0, "maximum": 511 },
              "removedDigits": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 1, "maximum": 9 }
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind"],
                "properties": {
                  "id": { "type": "string", "pattern": "^step-[0-9]{6}(?:-(?:cell-[1-9][0-9]*|candidate|unit|result))?$" },
                  "kind": { "enum": ["cell", "candidate", "unit", "branch"] },
                  "cell": { "$ref": "#/$defs/cell" },
                  "digit": { "type": "integer", "minimum": 1, "maximum": 9 },
                  "unit": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "index"],
                    "properties": {
                      "kind": { "enum": ["row", "column", "box"] },
                      "index": { "type": "integer", "minimum": 0, "maximum": 8 }
                    }
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "relation"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "relation": { "enum": ["supports", "excludes", "conflicts", "branches_to", "reverts"] }
                }
              }
            }
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["depth"],
          "properties": {
            "depth": { "type": "integer", "minimum": 0 },
            "parentStepId": { "type": "string", "pattern": "^step-[0-9]{6}$" }
          }
        },
        "explanationKey": { "type": "string", "pattern": "^(?:trace|hint)\\.[A-Za-z][A-Za-z0-9]*$" },
        "explanationParams": {
          "type": "object",
          "additionalProperties": { "type": ["integer", "string"] }
        }
      }
    }
  }
}
