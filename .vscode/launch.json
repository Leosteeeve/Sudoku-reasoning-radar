{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Sudoku Solver",
            "type": "cppdbg",
            "request": "launch",
            "program": "D:\\Soduku\\SudokuSolver.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "D:\\Soduku",
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:\\MSYS2\\ucrt64\\bin;D:\\MSYS2\\usr\\bin;${env:PATH}"
                },
                {
                    "name": "TEMP",
                    "value": "D:\\Soduku\\build_tmp"
                },
                {
                    "name": "TMP",
                    "value": "D:\\Soduku\\build_tmp"
                },
                {
                    "name": "TMPDIR",
                    "value": "D:\\Soduku\\build_tmp"
                }
            ],
            "externalConsole": true,
            "avoidWindowsConsoleRedirection": true,
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\MSYS2\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Build Sudoku Solver"
        },
        {
            "name": "Run Web Preview (Edge)",
            "type": "pwa-msedge",
            "request": "launch",
            "url": "http://localhost:8000/?fresh=web-parity-hotfix",
            "webRoot": "${workspaceFolder}\\docs\\play",
            "preLaunchTask": "Serve Web Preview"
        }
    ]
}
